# Copy these values into .env.development.local for local integration development.
# TikTok requires a public HTTPS callback, so use the tunnel URL here.
NEXT_PUBLIC_SITE_URL=https://your-domain.ngrok-free.dev

INSTAGRAM_INTEGRATION_ENABLED=false
INSTAGRAM_CLIENT_ID=your-instagram-app-id
INSTAGRAM_CLIENT_SECRET=your-instagram-app-secret
INSTAGRAM_API_VERSION=v25.0

TIKTOK_INTEGRATION_ENABLED=false
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
# Comma-separated HTTPS directory prefixes verified in the TikTok developer portal.
TIKTOK_VERIFIED_MEDIA_URL_PREFIXES=https://media.example.com/social/

INTEGRATION_CREDENTIAL_KEY_ID=local-v1
# A base64url-encoded 32-byte AES key; generate and store it in the deployment secret manager.
INTEGRATION_CREDENTIAL_KEY=replace-with-a-base64url-encoded-32-byte-key
