# Copy these values into .env.development.local for local integration development.
NEXT_PUBLIC_SITE_URL=https://your-domain.ngrok-free.dev
SALESFORCE_INTEGRATION_ENABLED=false
SALESFORCE_CLIENT_ID=your-salesforce-consumer-key
SALESFORCE_CLIENT_SECRET=your-salesforce-consumer-secret
SALESFORCE_LOGIN_URL=https://login.salesforce.com
# A custom Lead field configured as an External ID and Unique in Salesforce.
SALESFORCE_LEAD_EXTERNAL_ID_FIELD=Screeem_Delivery_Key__c
INTEGRATION_CREDENTIAL_KEY_ID=local-v1
# A base64url-encoded 32-byte AES key; generate and store it in the deployment secret manager.
INTEGRATION_CREDENTIAL_KEY=replace-with-a-base64url-encoded-32-byte-key
