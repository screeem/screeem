NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=https://your-domain.ngrok-free.dev

# Optional Cloudflare Turnstile protection for public form submissions
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Protects the durable routing action recovery worker
CRON_SECRET=replace-with-a-random-secret

# Server-side transaction connection. Use the Supabase transaction pooler in production.
# Local development receives this value from `make infra-up`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
