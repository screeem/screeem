{
  "name": "@screeem/billing",
  "version": "0.1.0",
  "description": "Effect billing service with an optional Stripe adapter",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stripe": {
      "types": "./dist/stripe.d.ts",
      "import": "./dist/stripe.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "^3.17.7"
  },
  "peerDependencies": {
    "stripe": "^22.5.0"
  },
  "peerDependenciesMeta": {
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "stripe": "^22.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "license": "ISC"
}
